# ═══════════════════════════════════════════════════════════════
# Enterprise Voice AI Platform — Environment Configuration
# Copy this file to .env and populate values for your deployment
# ═══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
# PORT: HTTP server port (default: 3000)
PORT=3000

# APP_URL: Public-facing URL for webhook callback registration
APP_URL="http://localhost:3000"

# NODE_ENV: Set to 'production' for prod builds (disables HMR)
NODE_ENV=

# Required for real AI voice call dispatch. Obtain from app.voice.hunar.ai
HUNAR_API_KEY=
HUNAR_BASE_URL="https://api.voice.hunar.ai"

# Screening agent ID (Module 1 — AI Hiring Assistant outbound calls)
HUNAR_SCREENING_AGENT_ID="0f870d5a-ba01-4a4a-bc97-611727aa1837"

# Talent reachout agent ID (Module 2 — bulk autonomous reachout)
HUNAR_REACHOUT_AGENT_ID="ffc1ebd5-6c44-4864-be80-cbf5e0ae8011"

# IVR attendance agent ID (Module 3 — inbound attendance check-in)
HUNAR_IVR_AGENT_ID="845421cc-5b74-43bc-a9ae-2aaf78b4e403"

# ── People Search API Keys (Module 2) ──────────────────────────
# Priority order: PDL → Apollo → Proxycurl → Coresignal → Mock fallback
# Leave all blank to use the verified talent pool mock fallback.

# People Data Labs — https://www.peopledatalabs.com/
PDL_API_KEY=

# Apollo.io — https://apollo.io/
APOLLO_API_KEY=

# Proxycurl LinkedIn API — https://nubela.co/proxycurl/
PROXYCURL_API_KEY=

# Coresignal Talent API — https://coresignal.com/
CORESIGNAL_API_KEY=

# ── LLM / AI Enhancement (Optional) ───────────────────────────
# OpenAI key for advanced NLP JD parsing (falls back to deterministic parser)
OPENAI_API_KEY=

# Google Gemini API Key for AI reasoning (optional enhancement)
GEMINI_API_KEY=

# ── Database ───────────────────────────────────────────────────
# SQLite (default dev) or PostgreSQL for production
# Examples:
#   SQLite:     sqlite:///./app.db
#   PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./app.db"
